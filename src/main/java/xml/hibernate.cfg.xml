<?xml version="1.0" encoding="UTF-8"?>
<hibernate-configuration>
    <session-factory>

        <!-- JDBC Driver -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <!-- Docker MySQL Connection -->
        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/resturent?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC
        </property>

        <!-- Database Username -->
        <property name="hibernate.connection.username">
            root
        </property>

        <!-- Database Password -->
        <property name="hibernate.connection.password">
            root
        </property>

        <!-- Hibernate Dialect -->
        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL8Dialect
        </property>

        <!-- Automatically Create/Update Tables -->
        <property name="hibernate.hbm2ddl.auto">
            update
        </property>

        <!-- SQL Logging -->
        <property name="hibernate.show_sql">
            true
        </property>

        <property name="hibernate.format_sql">
            true
        </property>

        <!-- Disable Cache -->
        <property name="hibernate.cache.use_second_level_cache">
            false
        </property>

        <property name="hibernate.cache.use_query_cache">
            false
        </property>

        <!-- Entity Mapping -->
        <mapping class="hiber.input"/>

    </session-factory>
</hibernate-configuration>